# Anchored to the root: a bare `contracts/` also matched src/app/contracts,
# and the /contracts page was left out of every deploy.
/contracts/
/drizzle/
/templates/
/tools/
*.md
!README.md
.env*
# Never upload secrets. These are gitignored, but the Vercel CLI does not
# read .gitignore: anything not listed here is uploaded with the source.
.sessions/
.agent-state/
*.session
*.key
scripts/vercel-env.sh
