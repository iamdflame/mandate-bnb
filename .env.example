# ── Required for the indexer only. The web app runs from the committed
#    snapshot without any of this.

# Postgres (Neon / Supabase / Railway)
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# 8004scan. Anonymous is 30 req/min; the hackathon Pro tier is 500/min.
SCAN_API_KEY=
SCAN_BASE_URL=https://api.8004scan.io/api/v1

# 56 = BSC mainnet, 97 = BSC testnet. This is the entire mainnet cutover.
CHAIN_ID=56
BSC_RPC_URL=https://bsc-rpc.publicnode.com
BSC_TESTNET_RPC_URL=https://bsc-testnet-rpc.publicnode.com

# Optional. Widens the Capability assay from a recent window to full history.
# No free BSC provider serves deep history; without this the scan is bounded
# and reports itself as such.
ARCHIVE_RPC_URL=

# Indexer pacing
AGENTS_PER_CYCLE=40
FEEDBACK_PAGES=45
CYCLE_MS=900000
