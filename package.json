{
  "name": "assay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The assay office for on-chain agents. Registry claim vs chain truth, with the proof attached.",
  "scripts": {
    "dev": "next dev",
    "build": "NODE_ENV=production next build",
    "start": "NODE_ENV=production next start",
    "worker": "tsx src/worker/index.ts",
    "worker:dev": "tsx watch src/worker/index.ts",
    "assay": "tsx src/scripts/assay.ts",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit",
    "snapshot": "tsx src/scripts/snapshot.ts",
    "sybil": "tsx src/scripts/sybil-check.ts",
    "funnel": "tsx src/scripts/funnel.ts",
    "shots": "tsx src/scripts/shots.ts",
    "abi": "python3 -c \"import json;a=json.load(open('contracts/out/MandateMarket.sol/MandateMarket.json'));open('src/lib/chain/abi.ts','w').write('/**\\n * MandateMarket ABI and bytecode, generated from the Foundry artifact.\\n *\\n * Regenerate with: npm run abi\\n */\\n\\nexport const MANDATE_MARKET_ABI = '+json.dumps(a['abi'],indent=2)+' as const;\\n\\nexport const MANDATE_MARKET_BYTECODE = '+json.dumps(a['bytecode']['object'])+' as \\`0x\\${string}\\`;\\n')\"",
    "contracts:build": "cd contracts && forge build",
    "contracts:test": "cd contracts && forge test",
    "floor": "tsx src/scripts/local-sim.ts",
    "adjudicator": "tsx src/scripts/adjudicator.ts",
    "index": "tsx src/scripts/index-agents.ts",
    "agent": "tsx src/agents/run.ts",
    "settle": "tsx src/scripts/settle.ts"
  },
  "dependencies": {
    "@altananetwork/sdk": "^0.7.1",
    "@bnbagent/sdk": "^0.5.5",
    "drizzle-orm": "^0.45.2",
    "next": "^15.5.25",
    "postgres": "^3.4.9",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "viem": "^2.56.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.4",
    "drizzle-kit": "^0.31.10",
    "playwright-core": "^1.62.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}